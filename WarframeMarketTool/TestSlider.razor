@* 测试组件：滑块 + 数据集合 *@
@using Microsoft.AspNetCore.Components

<h3>滑块测试</h3>

<MSlider @bind-Value="_testValue" Min="0" Max="10" Dense HideDetails="true" Style="max-width:200px;" />
<span>值: @_testValue</span>

<p>集合 @_items.Count 项</p>
<MDataTable Items="@_items" Headers="_headers" Dense HideDefaultFooter ItemsPerPage="-1" @key="@_refreshKey">
	<ItemColContent>
		@if (context.Header.Text == "值") { @context.Item }
		else if (context.Header.Text == "计算") { @(context.Item * 2) }
	</ItemColContent>
</MDataTable>

@code {
	private int _testValue = 0;
	private int _refreshKey;
	private List<int> _items = new() { 1, 2, 3, 4, 5 };
	private List<DataTableHeader<int>> _headers = new()
	{
		new("值", nameof(Int32)),
		new("计算", nameof(Int32)),
	};

	protected override void OnInitialized()
	{
		// 滑块变化时换数据 + 刷新
	}

	protected override void OnAfterRender(bool firstRender)
	{
		if (_prevValue != _testValue)
		{
			_prevValue = _testValue;
			_items = Enumerable.Range(_testValue, 5).ToList();
			_refreshKey++;
			StateHasChanged();
		}
	}

	private int _prevValue = -1;
}
