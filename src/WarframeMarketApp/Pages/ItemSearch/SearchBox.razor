@namespace WarframeMarketApp.Pages.ItemSearch
@using Serilog

<input @bind-Value="query" @bind-Value:event="oninput"
	   placeholder="输入物品名搜索（空格/· 为段分隔符，/ 分隔多词）"
	   style="flex:1;border:1px solid #ccc;border-radius:4px;padding:6px 10px;font-size:14px;max-width:600px;" />

<MButton Class="mt-1" Color="primary" Small OnClick="@(() => _ = DoSearch())">搜索</MButton>

@if (SavedQueries.Count > 0)
{
	<div class="d-flex flex-wrap align-center mb-2" style="gap:4px;">
		<span class="text-caption mr-1">收藏：</span>
		@foreach (var q in SavedQueries)
		{
			<MChip Small OnClick="@(() => OpenTab(q))" Class="mr-1">@q</MChip>
		}
		@if (canWrite && !string.IsNullOrWhiteSpace(query) && !SavedQueries.Contains(query))
		{
			<MButton Small Icon OnClick="SaveQuery">
				<MIcon Small>mdi-bookmark-outline</MIcon>
			</MButton>
		}
	</div>
}

@code {
	public string query { get; set; } = "";

	[Parameter] public EventCallback<string> OnSearch { get; set; }
	[Parameter] public EventCallback<string> OnFavoriteClick { get; set; }
	[CascadingParameter(Name = "CanWrite")] public bool canWrite { get; set; }

	public List<string> SavedQueries { get; set; } = new();

	private async Task DoSearch()
	{
		var q = query?.Trim();
		if (!string.IsNullOrWhiteSpace(q))
			await OnSearch.InvokeAsync(q);
	}

	private async Task OpenTab(string q)
	{
		query = q;
		await OnFavoriteClick.InvokeAsync(q);
	}

	private async Task SaveQuery()
	{
		if (!string.IsNullOrWhiteSpace(query) && !SavedQueries.Contains(query))
		{
			SavedQueries.Add(query);
			StateHasChanged();
		}
	}
}
