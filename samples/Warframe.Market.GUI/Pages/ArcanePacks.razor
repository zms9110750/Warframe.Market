@page "/arcane"
@attribute [NavItem("赋能包", "mdi-package-variant", Order = 2)]

<h3>赋能包查询</h3>

<text class="text-caption">
    这里列出的数字是指，购买一组小小黑赋能（2520荧尘）开箱子的期望价值。
    表头的数字是指每天购买多少组小小黑赋能。例如35是指一天买35组。
    如果某列期望值暴跌 → 开出的赋能比市场流通量还多，按成交量封顶。
</text>

<MDataTable Items="Pack" Headers="_headers" Dense Loading="@(_tasks.Values.Any(t => !t.IsCompleted))"
            ShowExpand ItemKey="r => r.Name" HideDefaultFooter
            MustSort SortBy="@nameof(ArcanePackConfig.Name)"  @* 必选排序（单选），默认按包名 *@
            Class="elevation-1 mt-2" ItemsPerPage="-1">
    <ExpandedItemContent>
        <td colspan="9999" @key="@context.Item.Name">
            <ArcaneTable Pack="context.Item" />
        </td>
    </ExpandedItemContent>
    <ItemColContent>
        @if (context.Header.Text == "赋能包")
        {
            @context.Item.Name
        }
        else if (int.TryParse(context.Header.Text, out var count)
            && _tasks.TryGetValue((context.Item.Name, count), out var task))
        {
            @(task.IsCompleted
                ? (task.Result.HasValue ? $"{task.Result.Value,-6:f1}" : "-") // 计算失败 → -（非 0.0 假数值）
                : "加载中")
        }
        else
        {
            @context.Value?.ToString()
        }
    </ItemColContent>
</MDataTable>

@code {
    [Inject] private ConfigService Config { get; set; } = null!;
    [Inject] private IArcanePackService Arcane { get; set; } = null!;

    private static readonly int[] PurchaseVolumes = [0, 2, 6, 15, 35];

    protected ArcanePackConfig[] Pack = [];
    protected List<DataTableHeader<ArcanePackConfig>> _headers = new();
    internal Dictionary<(string PackName, int Purchase), Task<double?>> _tasks = new();

    protected override Task OnInitializedAsync()
    {
        Log.Information("ArcanePacks 初始化");
        Pack = Config.LoadArcaneConfig();

        _headers.Add(new("赋能包", nameof(ArcanePackConfig.Name)));

        // 启动对所有包 × 购买量的计算（fire-and-forget：不阻塞组件初始化，每完成一个立即刷新）
        foreach (var pack in Pack)
        {
            foreach (var count in PurchaseVolumes)
            {
                var packName = pack.Name;
                _tasks[(packName, count)] = ComputeAsync(pack, count, packName);
            }
        }

        // 动态表头（购买量列）：排序值 = 对应计算任务的结果——任务未完成 → null（排最后），完成 → 数值
        // （参照原始实现：task.IsCompleted ? (float)task.Result : (double?)null）
        foreach (var count in PurchaseVolumes)
        {
            var c = count;
            _headers.Add(new(c.ToString(), c.ToString())
            {
                Align = DataTableHeaderAlign.End,
                ValueExpression = (Func<ArcanePackConfig, object?>)(pack =>
                    _tasks.TryGetValue((pack.Name, c), out var task) && task.IsCompleted && task.Result.HasValue
                        ? (float?)task.Result.Value // float? 自动装箱为 object?（未完成/失败 → null，排最后）
                        : null),
            });
        }

        // 200ms 轮询：加载期间周期性刷新（价格列逐格出现；独立任务中 StateHasChanged 有效）
        _ = PollUntilLoadedAsync();
        return Task.CompletedTask;
    }

    private readonly CancellationTokenSource _cts = new();

    // 渲染节流：45 个任务完成时逐个 StateHasChanged 会产生大量并发渲染批次，
    // 触发 PhotinoX 的 WebView 渲染批次竞态（"unexpected acknowledgement for render batch"）→ 页面报错。
    private DateTime _lastRefresh = DateTime.MinValue;
    private readonly object _refreshLock = new();

    /// <summary>节流版刷新：200ms 窗口内最多触发一次渲染（任务完成 + 轮询共用）</summary>
    private async Task RefreshThrottledAsync()
    {
        lock (_refreshLock)
        {
            if ((DateTime.UtcNow - _lastRefresh).TotalMilliseconds < 200)
            {
                return;
            }
            _lastRefresh = DateTime.UtcNow;
        }

        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // 组件已释放时忽略
        }
    }

    /// <summary>离开路由时取消未完成的计算/轮询</summary>
    public void Dispose()
    {
        _cts.Cancel();

        // 路由离开：本次用过的统计全部降级（Normal 可逐出），不再驻留
        Arcane.SetStatisticsPriority(Microsoft.Extensions.Caching.Memory.CacheItemPriority.Normal);
    }

    private async Task PollUntilLoadedAsync()
    {
        try
        {
            while (_tasks.Values.Any(t => !t.IsCompleted))
            {
                await Task.Delay(200, _cts.Token);
                await RefreshThrottledAsync();
            }

            await RefreshThrottledAsync(); // 全部完成后最终刷新一次
        }
        catch (OperationCanceledException)
        {
            // 路由离开取消，忽略
        }
        catch (Exception ex)
        {
            Log.Error(ex, "ArcanePacks 轮询异常");
        }
    }

    private async Task<double?> ComputeAsync(ArcanePackConfig pack, int count, string packName)
    {
        double? value = null;
        try
        {
            value = await Arcane.GetReferencePriceAsync(pack, count);
        }
        catch (Exception ex)
        {
            Log.Error(ex, "赋能包计算失败: {Pack} x{Count}", packName, count);
            value = null; // 失败 → null（渲染为 "-"，不显示 0.0 假数值）
        }
        finally
        {
            // 每次计算完成都记录刷新（验证动态刷新是否逐格触发）
            Log.Information("ArcanePacks 刷新: {Pack} x{Count} = {Value}", packName, count, value);
            await RefreshThrottledAsync(); // 节流：合并 45 任务的高频渲染，避免渲染批次竞态
        }
        return value;
    }
}
