@* 下载组件：进度条 + tgz 一键解压（无断点续传，全量下载） *@

<div class="d-flex align-center" style="gap:8px;margin:4px 0;">
    <MButton Small Outlined Color="primary" OnClick="StartDownload" Disabled="@(_downloading)">
        <MIcon Small Class="mr-1">mdi-download</MIcon>@Title
    </MButton>
    @if (Progress.HasValue)
    {
        <MProgressLinear Value="@Progress.Value" Style="max-width:260px;flex:1;" />
        <span class="text-caption">@ProgressText</span>
    }
    @if (_downloading)
    {
        <MButton Small Icon OnClick="Cancel"><MIcon Small>mdi-close</MIcon></MButton>
    }
</div>

@if (DonePath != null)
{
    <MAlert Dense Class="mt-1" Type="@AlertTypes.Success">已保存：@DonePath</MAlert>
}

@if (_error != null)
{
    <MAlert Dense Class="mt-1" Type="@AlertTypes.Error">@_error</MAlert>
}

@code {
    [Inject] private IHttpClientFactory HttpFactory { get; set; } = null!;

    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Url { get; set; } = "";
    [Parameter] public string SavePath { get; set; } = "";

    private double? Progress;
    private string ProgressText = "";
    private string? DonePath;
    private string? _error;
    private bool _downloading;
    private CancellationTokenSource? _cts;

    private async Task StartDownload()
    {
        _downloading = true;
        Progress = 0;
        DonePath = null;
        _error = null;
        _cts = new CancellationTokenSource();
        try
        {
            var dest = Path.Combine(AppContext.BaseDirectory, SavePath);
            Directory.CreateDirectory(Path.GetDirectoryName(dest)!);

            var http = HttpFactory.CreateClient();
            using var resp = await http.GetAsync(Url, HttpCompletionOption.ResponseHeadersRead, _cts.Token);
            resp.EnsureSuccessStatusCode();
            var total = resp.Content.Headers.ContentLength;

            await using var src = await resp.Content.ReadAsStreamAsync(_cts.Token);
            await using var dst = File.Create(dest);
            var buffer = new byte[81920];
            long read = 0;
            while (true)
            {
                var n = await src.ReadAsync(buffer, _cts.Token);
                if (n == 0) break;
                await dst.WriteAsync(buffer.AsMemory(0, n), _cts.Token);
                read += n;
                if (total is > 0)
                {
                    Progress = read * 100.0 / total.Value;
                    ProgressText = $"{read / 1048576.0:F1} / {total.Value / 1048576.0:F1} MB";
                    await InvokeAsync(StateHasChanged);
                }
            }

            // .tgz / .tar.gz 一键解压到同名目录
            if (dest.EndsWith(".tgz", StringComparison.OrdinalIgnoreCase) ||
                dest.EndsWith(".tar.gz", StringComparison.OrdinalIgnoreCase))
            {
                var extractDir = Path.Combine(Path.GetDirectoryName(dest)!, Path.GetFileNameWithoutExtension(dest));
                Directory.CreateDirectory(extractDir);
                await using var gz = File.OpenRead(dest);
                await using var tar = new System.IO.Compression.GZipStream(gz, System.IO.Compression.CompressionMode.Decompress);
                System.Formats.Tar.TarFile.ExtractToDirectory(tar, extractDir, true);
                DonePath = extractDir;
            }
            else
            {
                DonePath = dest;
            }
        }
        catch (OperationCanceledException) { _error = "已取消"; }
        catch (Exception ex) { _error = ex.Message; }
        finally
        {
            _downloading = false;
            _cts?.Dispose();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Cancel()
    {
        _cts?.Cancel();
    }
}
