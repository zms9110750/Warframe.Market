@page "/settings"
@attribute [NavItem("设置", "mdi-cog-outline", Order = 4)]

<h3>设置</h3>

<MAlert Dense Type="@AlertTypes.Info">
    数据版本：@State.VersionText。HTTP 响应缓存 30 分钟，点顶栏版本按钮（显示"再次点击强制刷新"后）可清缓存并重建物品索引。
</MAlert>

<h4 class="mt-4">语言 / 平台 / 跨平台</h4>

<style>
    .settings-lang-grid {
        display: grid;
        grid-template-columns: 200px 140px;
        row-gap: 2px;
        column-gap: 8px;
        align-items: center;
    }
</style>

<div class="settings-lang-grid mb-2">
    <div class="text-caption" style="font-weight:600;">下载语言包（缓存该语言 i18n）</div>
    <div class="text-caption" style="font-weight:600;">状态</div>
    @foreach (var li in langItems)
    {
        var isCore = li is "zh-hans" or "en";
        var fileExists = LocalizationDownloadService.IsDownloaded(li);
        var inConfig = _downloadedLangs.Contains(li);
        var isReadOnly = isCore || fileExists;                  // 核心语言 / 已下载完成 → 只读
        var isIndeterminate = !isReadOnly && inConfig;          // 配置标记但文件缺失 → 半选（可重新下载）
        <div>
            <MCheckbox Value="@(isCore || fileExists)"
                       Indeterminate="@isIndeterminate"
                       Disabled="@isReadOnly"
                       ValueChanged="@((bool v) => _ = ToggleDownload(li, v))"
                       Dense HideDetails="true">
                <ChildContent><span style="color:rgba(0,0,0,0.87);">@li</span></ChildContent>
            </MCheckbox>
        </div>
        <div>
            @if (isCore) { <span class="text-caption" style="color:#888;">核心</span> }
            else if (fileExists) { <span class="text-caption" style="color:#888;">已下载</span> }
            else if (isIndeterminate) { <span class="text-caption" style="color:#b26a00;">需重新下载</span> }
        </div>
    }
</div>

<div class="d-flex align-center mb-2" style="gap:12px;flex-wrap:wrap;">
    @* 平台：按钮组单选（与 OrderTop 购/售按钮组同款，已验证可靠） *@
    @foreach (var p in platItems)
    {
        <MButton Small Outlined="@(plat != p)" Color="@(plat == p ? "primary" : "")"
                 OnClick="@(() => { plat = p; State.Platform = AppState.StrToPlat(p); })">@p</MButton>
    }
    <MSwitch @bind-Value="crossplay" @bind-Value:after="@(() => State.Crossplay = crossplay)" Dense Inset HideDetails="true">
        <LabelContent>跨平台</LabelContent>
    </MSwitch>
    <MButton Small Color="primary" OnClick="Save">保存为默认</MButton>
</div>

<h4 class="mt-4">检查更新</h4>

<text class="text-caption">
    更新源：gitee.com/@(UpdateService.Owner)/@(UpdateService.Repo)。<br />
    .tgz / .tar.gz 文件下载后自动解压到程序目录；其他文件直接保存。
    打开上方"打开链接"开关可跳转浏览器下载。
</text>
<br /><br />
<MButton Small Color="primary" Outlined OnClick="LoadReleases">
    <MIcon Small Class="mr-1">mdi-update</MIcon>检查更新
</MButton>

@if (Releases != null)
{
    if (Releases.Length == 0) { <p class="text-caption mt-2">无发布版本</p> }
    @foreach (var r in Releases)
    {
        <ShowRelease Release="r" />
    }
}

@code {
    [Inject] private AppState State { get; set; } = null!;
    [Inject] private ConfigService Config { get; set; } = null!;
    [Inject] private UpdateService Updates { get; set; } = null!;
    [Inject] private LocalizationDownloadService Localizations { get; set; } = null!;

    private string plat = "pc";
    private bool crossplay = true;
    private HashSet<string> _downloadedLangs = new();
    private GiteeRelease[]? Releases;

    private List<string> langItems => Enum.GetValues<Language>()
        .Where(l => l != Language.Node)
        .Select(l => AppState.LangToStr(l)).ToList();
    private List<string> platItems => Enum.GetValues<Platform>()
        .Select(p => AppState.PlatToStr(p)).ToList();

    protected override void OnInitialized()
    {
        var cfg = Config.LoadAppConfig();
        plat = cfg.DefaultPlatform;
        crossplay = cfg.DefaultCrossplay;
        // 已下载的语言包：配置列表 + 本地已存在的 + 强制核心语言（zh-hans/en 只读勾选）
        _downloadedLangs = cfg.DownloadedLanguages
            .Concat(langItems.Where(LocalizationDownloadService.IsDownloaded))
            .ToHashSet();
        _downloadedLangs.Add("zh-hans");
        _downloadedLangs.Add("en");
    }

    /// <summary>勾选"下载语言包"：只允许打勾下载；已下载完成/核心语言由 Disabled 只读，不可取消</summary>
    private async Task ToggleDownload(string li, bool v)
    {
        if (!v) return; // 只读语言不可取消（UI 层 Disabled 已阻止，此处兜底）
        if (await Localizations.DownloadAsync(li))
        {
            _downloadedLangs.Add(li);
            Log.Information("Settings 语言包已下载: {Lang}", li);
        }
    }

    private void Save()
    {
        Config.SaveAppConfig(new AppConfig
        {
            // 界面语言固定中文（不做界面语言切换）
            DefaultLanguage = "zh-hans",
            DefaultPlatform = plat,
            DefaultCrossplay = crossplay,
            DownloadedLanguages = _downloadedLangs.ToList(),
        });
        Log.Information("Settings 保存默认配置: {Plat}/crossplay={Cross}, 语言包={Langs}",
            plat, crossplay, string.Join(",", _downloadedLangs));
    }

    private async Task LoadReleases()
    {
        Log.Information("Settings 检查更新");
        Releases = await Updates.GetReleasesAsync();
        StateHasChanged();
    }
}
