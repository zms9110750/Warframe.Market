@* 搜索结果标签栏（无"搜索"tab；图钉开关开启时：钉住的显示 pin-off、未钉住的显示 MChip 原生 x 可关闭） *@

<MTabs Value="@activeTabIndex">
    @foreach (var (tab, idx) in _activeTabs.Select((t, i) => (t, i)))
    {
        var isPinned = pinned.Contains(tab);
        var isWelcome = tab == "欢迎";
        <MTab OnClick="@(() => activeTabIndexChanged.InvokeAsync(idx))" Style="min-width:120px;">
            <MChip Label Class="mr-1" OnClick="@(() => activeTabIndexChanged.InvokeAsync(idx))"
                   Close="@(!isWelcome && !pin && !isPinned)"
                   OnCloseClick="@(() => CloseTab.InvokeAsync(idx))">
                @tab
                @if (!isWelcome && pin)
                {
                    @* 图钉模式：所有 tab 显示 pin 图标（已钉住=橙 pin-off 取消，未钉住=灰 pin-outline 钉住）——JM 式 *@
                    <span @onclick:stopPropagation
                          @onclick="@(() => TogglePin.InvokeAsync(tab))"
                          style="display:inline-flex;cursor:pointer;"
                          title="@(isPinned ? "取消钉住" : "钉住")">
                        <MIcon XSmall Color="@(isPinned ? "orange" : "grey")">
                            @(isPinned ? "mdi-pin-off" : "mdi-pin-outline")
                        </MIcon>
                    </span>
                }
            </MChip>
        </MTab>
    }
</MTabs>

@code {
    [Parameter] public int activeTabIndex { get; set; }
    [Parameter] public EventCallback<int> activeTabIndexChanged { get; set; }
    [Parameter] public List<string> _activeTabs { get; set; } = new();
    [Parameter] public HashSet<string> pinned { get; set; } = new();
    [Parameter] public bool pin { get; set; }
    [Parameter] public EventCallback<string> TogglePin { get; set; }
    [Parameter] public EventCallback<int> CloseTab { get; set; }
}
