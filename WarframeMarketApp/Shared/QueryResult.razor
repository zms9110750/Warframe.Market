@* 单个搜索词的结果组，可折叠，含物品表格 + OrderTop *@
@using zms9110750.WarframeMarketApi.Models.Items

<MDivider Class="my-2" />

<MButton Small Text OnClick="@(() => HideChanged.InvokeAsync(Item.Id))" Class="mb-1">
	@if (IsHide) { <MIcon Small>mdi-chevron-right</MIcon> }
	else { <MIcon Small>mdi-chevron-down</MIcon> }
	@Item.I18n.TryGetValue(Language.ZhHans, out var zh) ? zh.Name : Item.Slug
</MButton>

<ShowTransitionElement Value="@(!IsHide)">
	<MDataTable Items="@(new[] { Item })" Headers="_headers" Dense ShowExpand
				HideDefaultFooter ItemsPerPage="-1" @key="Item.Id"
				Class="elevation-1" ItemKey="r => r.Id">
		<ItemColContent>
			@if (context.Header.Text == "中文名称")
			{
				if (ClickLink)
				{
					<a href="@($"https://warframe.market/zh-hans/items/{Item.Slug}")">@(Item.I18n.TryGetValue(Language.ZhHans, out var z) ? z.Name : Item.Slug)</a>
				}
				else
				{
					@(Item.I18n.TryGetValue(Language.ZhHans, out var z) ? z.Name : Item.Slug)
				}
			}
			else if (context.Header.Text == "英文名称")
			{
				@(Item.I18n.TryGetValue(Language.En, out var e) ? e.Name : "")
			}
			else if (context.Header.Text == "价格")
			{
				if (ClickLink && Price.HasValue)
				{
					<a href="@($"https://warframe.market/zh-hans/items/{Item.Slug}/statistics")">@Price?.ToString("F1")</a>
				}
				else
				{
					@(Price?.ToString("F1") ?? "")
				}
			}
			else if (context.Header.Text == "满级价格")
			{
				if (ClickLink && MaxPrice.HasValue)
				{
					<a href="@($"https://warframe.market/zh-hans/items/{Item.Slug}/statistics")">@MaxPrice?.ToString("F1")</a>
				}
				else
				{
					@(MaxPrice?.ToString("F1") ?? "")
				}
			}
			else { @context.Value?.ToString() }
		</ItemColContent>
		<ExpandedItemContent>
			<td colspan="4" @key="Item.Id">
				<OrderTop Item="@Item" />
			</td>
		</ExpandedItemContent>
	</MDataTable>
</ShowTransitionElement>

@code {
	[Parameter] public ItemShort Item { get; set; } = default!;
	[Parameter] public bool IsHide { get; set; }
	[Parameter] public EventCallback<string> HideChanged { get; set; }
	[Parameter] public double? Price { get; set; }
	[Parameter] public double? MaxPrice { get; set; }
	[CascadingParameter(Name = "ClickLink")] public bool ClickLink { get; set; }

	private List<DataTableHeader<ItemShort>> _headers = new()
	{
		new("中文名称", "zh"),
		new("英文名称", "en"),
		new("价格", "price") { Align = DataTableHeaderAlign.End },
		new("满级价格", "maxprice") { Align = DataTableHeaderAlign.End },
	};
}
