@* 每个搜索词的结果表：内置异步价格加载 + 渐进刷新 *@
@using zms9110750.WarframeMarketApi.Models.Items
@using zms9110750.WarframeMarketApi.Models.Statistics
@inject ItemsService ItemSvc

@if (results.Count == 0) { return; }

<p class="text-caption mt-2">@Tab — 共 @results.Count 个结果</p>

<MDataTable Items="results" Headers="_headers" Dense MultiSort ShowExpand
			HideDefaultFooter ItemsPerPage="-1" @key="Tab"
			Class="elevation-1">
	<ItemColContent>
		@if (context.Header.Text == "中文名称")
		{
			@(context.Item.I18n.TryGetValue(Language.ZhHans, out var z) ? z.Name : context.Item.Slug)
		}
		else if (context.Header.Text == "英文名称")
		{
			@(context.Item.I18n.TryGetValue(Language.En, out var e) ? e.Name : "")
		}
		else if (context.Header.Text == "价格")
		{
			@(_prices.TryGetValue(context.Item.Slug, out var p) && p.HasValue ? $"{p:F1}" : "")
		}
		else if (context.Header.Text == "满级价格")
		{
			@(_maxPrices.TryGetValue(context.Item.Slug, out var mp) && mp.HasValue ? $"{mp:F1}" : "")
		}
	</ItemColContent>
	<ExpandedItemContent>
		<td colspan="@_headers.Count" @key="context.Item.Id">
			<OrderTop Item="@((ItemShort)context.Item)" />
		</td>
	</ExpandedItemContent>
</MDataTable>

@code {
	[Parameter] public string Tab { get; set; } = "";
	[Parameter] public List<ItemShort> results { get; set; } = new();
	[CascadingParameter(Name = "ClickLink")] public bool ClickLink { get; set; }

	private List<DataTableHeader<ItemShort>> _headers = new()
	{
		new("中文名称", "zh"),
		new("英文名称", "en"),
		new("价格", "price") { Align = DataTableHeaderAlign.End },
		new("满级价格", "maxprice") { Align = DataTableHeaderAlign.End },
	};

	private Dictionary<string, Statistic?> _stats = new();
	private Dictionary<string, double?> _prices = new();
	private Dictionary<string, double?> _maxPrices = new();

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();

		var geting = new HashSet<Task<Statistic?>>();
		var slugToTask = new Dictionary<string, Task<Statistic?>>();

		foreach (var item in results)
		{
			var task = ItemSvc.GetStatisticAsync(item.Slug);
			slugToTask[item.Slug] = task;
			if (!task.IsCompleted)
				geting.Add(task);
		}

		var allTasks = Task.WhenAll(geting);

		// 渐进刷新：等 200ms → 检查已完成的任务 → 刷新 → 继续
		do
		{
			foreach (var item in results)
			{
				if (_stats.ContainsKey(item.Slug)) continue;
				var task = slugToTask[item.Slug];
				if (task.IsCompleted)
				{
					var stat = task.Result;
					_stats[item.Slug] = stat;
					_prices[item.Slug] = stat != null ? ItemSvc.GetReferencePrice(stat) : null;
					_maxPrices[item.Slug] = stat != null ? ItemSvc.GetMaxReferencePrice(stat) : null;
				}
			}
			StateHasChanged();
			await Task.Delay(200);
		} while (!allTasks.IsCompleted);

		// 最后补一轮
		foreach (var item in results)
		{
			if (!_stats.ContainsKey(item.Slug))
			{
				var stat = await slugToTask[item.Slug];
				_stats[item.Slug] = stat;
				_prices[item.Slug] = stat != null ? ItemSvc.GetReferencePrice(stat) : null;
				_maxPrices[item.Slug] = stat != null ? ItemSvc.GetMaxReferencePrice(stat) : null;
			}
		}
		StateHasChanged();
	}
}
