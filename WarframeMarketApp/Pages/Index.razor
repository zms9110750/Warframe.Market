@page "/"
@attribute [NavItem("首页", "mdi-home", Order = 0)]

<MTitle Class="mb-6">Warframe Market 查询工具</MTitle>

<MCard Class="mb-4">
    <MCardText>
        <p>客户端状态：<MAlert Dense Type="@(ready ? AlertTypes.Success : AlertTypes.Warning)" Class="d-inline-flex pa-2">@status</MAlert></p>
    </MCardText>
</MCard>

<MButton Color="primary" OnClick="TestApi" Loading="loading">测试 API 连接</MButton>

@if (result != null)
{
    <MAlert Class="mt-4" Type="@(ok ? AlertTypes.Success : AlertTypes.Error)">@result</MAlert>
}

@code {
    private string status = "初始化中...";
    private string? result;
    private bool ready;
    private bool ok;
    private bool loading;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Wfm.GetVersionsAsync();

            if (response?.Content?.Data != null)
            {
                var v = response.Content.Data;
                status = $"已连接 — 数据版本: {v.UpdatedAtLocal:yyyy-MM-dd HH:mm:ss}";
                ready = true;
            }
            else if (response?.Content != null && response.Content.Error != null)
            {
                status = $"API 错误: {response.Content.Error}";
            }
            else if (response?.Content == null)
            {
                status = $"响应内容为空 (HTTP {(int?)response?.StatusCode} {response?.StatusCode})";
            }
            else
            {
                status = $"Data 为空，ApiVersion={response.Content.ApiVersion}, Status={response?.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            status = $"错误: {ex.Message}";
        }
    }

    private async Task TestApi()
    {
        loading = true;
        try
        {
            var response = await Wfm.GetItemsAsync();

            if (response?.Content?.Data != null)
            {
                result = $"获取到 {response.Content.Data.Length} 个可交易物品";
                ok = true;
            }
            else if (response?.Content != null && response.Content.Error != null)
            {
                result = $"API 错误: {response.Content.Error}";
                ok = false;
            }
            else if (response?.Content == null)
            {
                result = $"响应内容为空 (HTTP {(int?)response?.StatusCode} {response?.StatusCode})";
                ok = false;
            }
            else
            {
                result = $"Data 为空，ApiVersion={response.Content.ApiVersion}";
                ok = false;
            }
        }
        catch (Exception ex)
        {
            result = $"异常: {ex.Message}";
            ok = false;
        }
        loading = false;
    }
}
