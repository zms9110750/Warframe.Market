@page "/"
@attribute [NavItem("首页", "mdi-home", Order = 0)]

<MTitle Class="mb-6">Warframe Market 查询工具</MTitle>

<MCard Class="mb-4">
	<MCardText>
		<p>当前设置：</p>
		<ul>
			<li>语言：<strong>@stateLang</strong></li>
			<li>平台：<strong>@statePlat</strong></li>
			<li>跨平台：<strong>@stateCross</strong></li>
		</ul>
	</MCardText>
</MCard>

<MButton Color="primary" OnClick="TestApi" Disabled="@State.IsUpdating" Loading="@loading">查询物品数量</MButton>

@if (result != null)
{
	<MAlert Class="mt-4" Type="@(ok ? AlertTypes.Success : AlertTypes.Error)">@result</MAlert>
}
