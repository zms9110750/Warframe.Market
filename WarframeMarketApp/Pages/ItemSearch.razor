@page "/"
@attribute [NavItem("物品搜索", "mdi-magnify", Order = 0)]

<SearchBox OnSearch="@OnSearch" OnFavoriteClick="@OnFavoriteClick" />

@if (activeTabs.Count == 0)
{
	@if (readme != null)
	{
		@((MarkupString)readme)
	}
	else
	{
		<MAlert Dense Type="@AlertTypes.Info" Class="mt-4">在上方输入框搜索物品。支持中文、英文、物品 ID。用 / 分隔多词。</MAlert>
	}
}
else
{
	<MTabs Value="@activeTabIndex">
		@foreach (var (tab, idx) in activeTabs.Select((t, i) => (t, i)))
		{
			<MTab OnClick="@(() => { activeTabIndex = idx; StateHasChanged(); })">
				@(tab.Length > 20 ? $"{tab[..20]}…" : tab)
				<MButton Small Icon OnClick="@(() => CloseTab(idx))" Class="ml-1">
					<MIcon Small>mdi-close</MIcon>
				</MButton>
			</MTab>
		}

		<MTabsItems>
			@foreach (var (tab, idx) in activeTabs.Select((t, i) => (t, i)))
			{
				<MTabItem Value="@idx">
					@if (tabResults.TryGetValue(tab, out var results) && results.Count > 0)
					{
						<SearchResultTable Tab="@tab" results="@results" />
					}
					else if (searchingTabs.Contains(tab))
					{
						<MProgressCircular Indeterminate Size="20" Width="2" Class="mt-4" />
					}
					else
					{
						<p class="text-caption mt-2">无匹配结果</p>
					}
				</MTabItem>
			}
		</MTabsItems>
	</MTabs>
}
