@page "/"
@attribute [NavItem("物品搜索", "mdi-magnify", Order = 0)]

<SearchBox OnSearch="@OnSearch" OnFavoriteClick="@OnFavoriteClick" />

@if (activeTabs.Count == 0)
{
	@if (readme != null)
	{
		@((MarkupString)readme)
	}
	else
	{
		<MAlert Dense Type="@AlertTypes.Info" Class="mt-4">在上方输入框搜索物品。支持中文、英文、物品 ID。用 / 分隔多词。</MAlert>
	}
}
else
{
	@* 手动标签头 *@
	<div class="d-flex flex-wrap align-center mb-2" style="gap:2px;">
		@foreach (var (tab, idx) in activeTabs.Select((t, i) => (t, i)))
		{
			<MChip @key="tab"
				   Class="@(idx == activeTabIndex ? "primary" : "")"
				   Close OnCloseClick="@(() => CloseTab(idx))"
				   OnClick="@(() => activeTabIndex = idx)">
				@(tab.Length > 20 ? $"{tab[..20]}…" : tab)
			</MChip>
		}
	</div>

	@* 当前标签内容 *@
	@if (activeTabIndex >= 0 && activeTabIndex < activeTabs.Count)
	{
		var tab = activeTabs[activeTabIndex];
		if (tabResults.TryGetValue(tab, out var results) && results.Count > 0)
		{
			<p class="text-caption">@tab — 共 @results.Count 个结果</p>
			@foreach (var item in results)
			{
				<QueryResult Item="item"
							 Price="@(Prices.GetValueOrDefault(item.Slug))"
							 MaxPrice="@(MaxPrices.GetValueOrDefault(item.Slug))"
							 IsHide="@(hiddenResults.Contains((tab, item.Id)))"
							 HideChanged="@(key => ToggleHide(tab, key))" @key="item.Id" />
			}
		}
		else if (searchingTabs.Contains(tab))
		{
			<MProgressCircular Indeterminate Size="20" Width="2" Class="mt-4" />
		}
		else
		{
			<p class="text-caption mt-2">无匹配结果</p>
		}
	}
}
