@page "/"
@attribute [NavItem("物品搜索", "mdi-magnify", Order = 0)]

<h3>物品搜索</h3>

<MTextField @bind-Value="query"
			Label="输入物品名搜索"
			Clearable
			OnKeyDown="@(e => { if (e.Key == "Enter") _ = DoSearch(); })"
			Dense Solo Class="mb-4" Style="max-width: 500px;" />

<MButton OnClick="DoSearch" Color="primary">搜索</MButton>

@if (ItemsList.Count > 0)
{
	<MDataTable Items="ItemsList" Headers="_headers" Dense MultiSort ShowExpand
				HideDefaultFooter ItemsPerPage="-1" @key="query"
				Class="elevation-1 mt-4">
		<ItemColContent>
			@if (context.Header.Text == "中文名称") { @(context.Item.I18n.TryGetValue(Language.ZhHans, out var z) ? z.Name : context.Item.Slug) }
			else if (context.Header.Text == "英文名称") { @(context.Item.I18n.TryGetValue(Language.En, out var e) ? e.Name : "") }
			else if (context.Header.Text == "价格") { @GetPrice(context.Item.Slug) }
			else if (context.Header.Text == "满级价格") { @GetMaxPrice(context.Item.Slug) }
			else { @context.Value?.ToString() }
		</ItemColContent>
		<ExpandedItemContent>
			<td colspan="4" @key="context.Item.Id">
				<OrderTop Item="@((ItemShort)context.Item)" />
			</td>
		</ExpandedItemContent>
	</MDataTable>
	<p class="mt-2 text-caption">共 @ItemsList.Count 个结果</p>
}
else if (searched) { <p class="mt-2">无匹配</p> }
