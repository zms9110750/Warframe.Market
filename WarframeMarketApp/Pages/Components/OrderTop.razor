@using zms9110750.WarframeMarketApi.Models.Orders
@using zms9110750.WarframeMarketApi.Models.Users

@if (TargetItem == null) { <MAlert Dense Type="@AlertTypes.Warning">没有必需参数</MAlert> return; }

@* 筛选开关 *@
<div class="d-flex align-center mb-2" style="gap:12px;">
	<MSwitch @bind-Value="_showBuy" Dense Inset HideDetails="true">
		<LabelContent>@(_showBuy ? "购" : "售")</LabelContent>
	</MSwitch>
	<input type="range" min="0" max="@_maxRankValue" 
		   value="@_selectedRank"
		   @oninput="@((ChangeEventArgs e) => _selectedRank = int.TryParse(e.Value?.ToString(), out var v) ? v : 0)"
		   @onchange="@(() => _ = RefreshWithRankAsync())"
		   style="max-width:150px;margin:0 12px;" />
	<span>等级 @_selectedRank</span>
</div>

<MDataTable Items="@FilteredOrders" Headers="_headers" Dense HideDefaultFooter ItemsPerPage="-1"
			GroupBy="nameof(Order.Type)" GroupDesc="[true]"
			Loading="@loading" @key="@TargetItem.Id">
	<GroupHeaderContent>
		<td colspan="@_headers.Count">
			@if (context.Group is "buy" or "Buy") { @("购") }
			else { @("售") }
		</td>
	</GroupHeaderContent>
	<ItemColContent>
		@if (context.Header.Text == "联系")
		{
			var locale = context.Item.User?.Locale;
			var enName = TargetItem.I18n.TryGetValue(Language.En, out var en) ? en.Name : TargetItem.Slug;
			var zhName = locale == "zh-hans" && TargetItem.I18n.TryGetValue(Language.ZhHans, out var zh) ? zh.Name : null;
			var hasSubtype = context.Item.Subtype != null ? $" of {context.Item.Subtype}" : null;
			var rank = context.Item.Rank != null ? $" rank {context.Item.Rank}" : null;
			var type = context.Item.Type is "buy" or "Buy" ? "sell" : "buy";
			var msg = $"/w {context.Item.User?.IngameName} Hi! I want to {type}: \"{enName}\"{zhName}{hasSubtype}{rank} for {context.Item.Platinum} platinum.";
			<MButton Small Outlined Color="primary" OnClick="@(() => _ = CopyAsync(msg))">私信</MButton>
		}
		else if (context.Header.Text == "卖家")
		{
			var nameStr = context.Item.User?.IngameName ?? "";
			if (ClickLink)
			{
				<a href="@($"https://warframe.market/zh-hans/profile/{nameStr}")">@nameStr</a>
			}
			else
			{
				<text>@nameStr</text>
			}
		}
		else
		{
			@(context.Value switch
			{
				null => "",
				"blueprint" => "蓝图", "crafted" => "成品",
				"intact" => "完整", "radiant" => "光辉",
				"revealed" => "已揭示", "unrevealed" => "未揭示",
				"exceptional" => "优良", "flawless" => "无暇",
				string s when s.StartsWith("zh-") => s == "zh-hans" ? "简体中文" : "繁体中文",
				"en" => "英语", "ko" => "韩语", "ru" => "俄语", "de" => "德语",
				"fr" => "法语", "pt" => "葡萄牙语", "es" => "西班牙语",
				"it" => "意大利语", "pl" => "波兰语", "uk" => "乌克兰语",
				_ => context.Value?.ToString()
			})
		}
	</ItemColContent>
</MDataTable>
