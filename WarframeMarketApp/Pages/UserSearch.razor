@page "/user"
@attribute [NavItem("用户订单", "mdi-account-search", Order = 1)]

<MTextField @bind-Value="slug"
			Label="输入 Warframe 用户名"
			Clearable
			@onkeydown="@(e => { if (e.Key == "Enter") _ = SearchAsync(); })"
			Dense Solo Class="mb-4" Style="max-width: 400px;" />

<MButton OnClick="SearchAsync" Disabled="@loading" Loading="@loading" Color="primary">查询</MButton>

@if (notFound)
{
	<MAlert Dense Type="@AlertTypes.Error" Class="mt-2">未找到该用户：@slug</MAlert>
}
else if (user != null)
{
	<p class="mt-2"><strong>@user.IngameName</strong> — @user.Platform — 声望 @user.Reputation — @user.LastSeenLocal.ToString("g")</p>
}

@if (orders != null && orders.Count > 0)
{
	<p class="mt-2">共 @orders.Count 个订单 @(loadingPrices ? " — 加载中..." : "")</p>

	@foreach (var group in orders.GroupBy(o => o.Type is "buy" or "Buy" ? "购" : "售"))
	{
		<h4 class="mt-3">@group.Key</h4>
		<MDataTable Items="@group.ToList()" Headers="_headers" Dense HideDefaultFooter ItemsPerPage="-1" @key="@(slug + group.Key)"
					Loading="@loading" ShowExpand ItemKey="r => r.Id" Context="ctx">
			<ItemColContent>
				@if (ctx.Header.Text == "物品")
				{
					@GetItemName(ctx.Item)
				}
				else if (ctx.Header.Text == "类型") { @(ctx.Item.Type is "buy" or "Buy" ? "购" : "售") }
				else if (ctx.Header.Text == "参考价") { @GetRef(ctx.Item) }
				else if (ctx.Header.Text == "差价") { @GetDiff(ctx.Item) }
				else { @ctx.Value?.ToString() }
			</ItemColContent>
			<ExpandedItemContent>
				<td colspan="9999" @key="ctx.Item.Id">
					<OrderTop TargetItem="@GetItemShort(ctx.Item)" />
				</td>
			</ExpandedItemContent>
		</MDataTable>
	}
}
else if (searched && !loading) { <p class="mt-2">无公开订单</p> }

@if (error != null) { <p style="color:#c62828;">@error</p> }
