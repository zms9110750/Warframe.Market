@page "/user"
@attribute [NavItem("用户订单", "mdi-account-search", Order = 1)]

<h3>用户订单查询</h3>

<MTextField @bind-Value="slug"
			Label="输入 Warframe 用户名"
			Clearable
			OnKeyDown="@(e => { if (e.Key == "Enter") _ = SearchAsync(); })"
			Dense Solo Class="mb-4" Style="max-width: 400px;" />

<MButton OnClick="SearchAsync" Disabled="@loading" Loading="@loading" Color="primary">查询</MButton>

@if (user != null)
{
	<MCard Class="mt-4 pa-3" Outlined>
		<div style="display:flex;gap:16px;flex-wrap:wrap;align-items:center;">
			<span><strong>@user.IngameName</strong></span>
			<span>平台: @user.Platform</span>
			<span>声望: @user.Reputation</span>
			<span>@user.LastSeenLocal.ToString("g")</span>
		</div>
	</MCard>
}

@if (orders != null && orders.Count > 0)
{
	<p class="mt-2">共 @orders.Count 个订单 @(loadingPrices ? " — 加载中..." : "")</p>

	@foreach (var o in orders)
	{
		<MCard key="@o.Id" Class="mt-2 pa-3" Outlined>
			<div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;">
				<span style="min-width:100px;"><strong>@GetItemName(o)</strong></span>
				<span style="min-width:40px;">@(o.Type == "sell" ? "售" : "购")</span>
				<span style="min-width:50px;">@o.Platinum</span>
				<span style="min-width:20px;">x@o.Quantity</span>
				<span style="min-width:60px;">参考 @GetRef(o)</span>
				<span style="min-width:60px;">@GetDiff(o)</span>
			</div>
		</MCard>
	}
}
else if (searched && !loading) { <p class="mt-2">无公开订单</p> }

@if (error != null) { <p style="color:#c62828;">@error</p> }
