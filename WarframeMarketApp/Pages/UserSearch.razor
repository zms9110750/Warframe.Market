@page "/user"
@attribute [NavItem("用户订单", "mdi-account-search", Order = 1)]

@* 标签栏 *@
<MTabs Value="@activeTabIndex">
	<MTab OnClick="@(() => { activeTabIndex = 0; StateHasChanged(); })">搜索</MTab>
	@foreach (var (name, idx) in _pinnedUsers.Select((t, i) => (t, i)))
	{
		var realIdx = idx + 1;
		<MTab OnClick="@(() => { activeTabIndex = realIdx; StateHasChanged(); })">
			@name
			@if (canWrite)
			{
				<MButton Small Icon OnClick="@(() => UnpinUser(name))">
					<MIcon Small Style="color:orange;">mdi-pin-off</MIcon>
				</MButton>
			}
		</MTab>
	}
	@foreach (var (name, idx) in _activeUsers.Select((t, i) => (t, i)))
	{
		if (_pinnedUsers.Contains(name)) continue;
		var realIdx = idx + 1 + _pinnedUsers.Count;
		<MTab OnClick="@(() => { activeTabIndex = realIdx; StateHasChanged(); })">
			@(name.Length > 20 ? $"{name[..20]}…" : name)
			@if (canWrite)
			{
				<MButton Small Icon OnClick="@(() => PinUser(name))">
					<MIcon Small>mdi-pin-outline</MIcon>
				</MButton>
			}
			else
			{
				<MButton Small Icon OnClick="@(() => CloseUserTab(idx))">
					<MIcon Small>mdi-close</MIcon>
				</MButton>
			}
		</MTab>
	}
</MTabs>

@if (activeTabIndex == 0)
{
	<MTextField @bind-Value="slug" Label="输入用户名（/分隔多用户）" Clearable Dense Solo Class="mb-4" Style="max-width: 400px;" />
	<MButton OnClick="SearchAsync" Color="primary">查询</MButton>
}

@* 显示所有已加载用户的结果 *@
@{
	var allUsers = new List<string>();
	allUsers.AddRange(_pinnedUsers);
	allUsers.AddRange(_activeUsers.Where(u => !_pinnedUsers.Contains(u)));
	var userIdx = activeTabIndex - 1;
}
@if (userIdx >= 0 && userIdx < allUsers.Count)
{
	var currentUser = allUsers[userIdx];
	if (_userResults.TryGetValue(currentUser, out var result))
	{
		if (result.Error != null) { <p style="color:#c62828;">@result.Error</p> }
		else if (result.NotFound) { <MAlert Dense Type="@AlertTypes.Error">未找到该用户：@currentUser</MAlert> }
		else
		{
			if (result.User != null)
			{
				<p class="mt-2"><strong>@result.User.IngameName</strong> — @result.User.Platform — 声望 @result.User.Reputation — @result.User.LastSeenLocal.ToString("g")</p>
			}
			if (result.Orders != null && result.Orders.Count > 0)
			{
				<p class="mt-2">共 @result.Orders.Count 个订单 @(result.LoadingPrices ? " — 加载中..." : "")</p>
				<MDataTable Items="result.Orders" Headers="_headers" Dense HideDefaultFooter ItemsPerPage="-1" Loading="@result.Loading"
							ShowExpand ItemKey="r => r.Id"
							GroupBy="nameof(Order.Type)" GroupDesc="[true]">
					<GroupHeaderContent>
						<td colspan="@_headers.Count">
							@if (context.Group is "buy" or "Buy") { @("购") } else { @("售") }
						</td>
					</GroupHeaderContent>
					<ItemColContent>
						@if (context.Header.Text == "物品") { @GetItemName(result, context.Item) }
						else if (context.Header.Text == "英文名称") { @GetEnName(result, context.Item) }
						else if (context.Header.Text == "参考价") { @GetRef(result, context.Item) }
						else if (context.Header.Text == "差价") { @GetDiff(result, context.Item) }
						else { @context.Value?.ToString() }
					</ItemColContent>
					<ExpandedItemContent>
						<td colspan="9999"><OrderTop TargetItem="@GetItemShort(result, context.Item2)" /></td>
					</ExpandedItemContent>
				</MDataTable>
			}
			else if (!result.Loading) { <p>无公开订单</p> }
		}
	}
	else if (_searchingUsers.Contains(currentUser)) { <MProgressCircular Indeterminate Size="20" Width="2" Class="mt-4" /> }
}
