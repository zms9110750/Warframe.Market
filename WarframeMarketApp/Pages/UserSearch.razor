@page "/user"
@attribute [NavItem("用户订单", "mdi-account-search", Order = 1)]

<h3>用户订单查询</h3>

<MTextField @bind-Value="slug"
			Label="输入 Warframe 用户名"
			Clearable
			OnKeyDown="@(e => { if (e.Key == "Enter") _ = SearchAsync(); })"
			Dense Solo Class="mb-4" Style="max-width: 400px;" />

<MButton OnClick="SearchAsync" Disabled="@loading" Loading="@loading" Color="primary">查询</MButton>

@if (user != null)
{
	<p class="mt-2"><strong>@user.IngameName</strong> — @user.Platform — 声望 @user.Reputation — @user.LastSeenLocal.ToString("g")</p>
}

@if (orders != null && orders.Count > 0)
{
	<p class="mt-2">共 @orders.Count 个订单 @(loadingPrices ? " — 加载中..." : "")</p>

	<MDataTable Items="orders" Headers="_headers" Dense HideDefaultFooter ItemsPerPage="-1" @key="slug"
				Loading="@loading">
		<ItemColContent>
			@if (context.Header.Text == "类型") { @(context.Item.Type == "sell" ? "售" : "购") }
			else if (context.Header.Text == "物品") { @GetItemName(context.Item) }
			else if (context.Header.Text == "参考价") { @GetRef(context.Item) }
			else if (context.Header.Text == "差价") { @GetDiff(context.Item) }
			else { @context.Value?.ToString() }
		</ItemColContent>
	</MDataTable>
}
else if (searched && !loading) { <p class="mt-2">无公开订单</p> }

@if (error != null) { <p style="color:#c62828;">@error</p> }
