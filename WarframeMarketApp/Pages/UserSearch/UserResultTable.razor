@* 用户订单结果表，可折叠 *@
@using zms9110750.WarframeMarketApi.Models.Orders
@using zms9110750.WarframeMarketApi.Models.Users
@using WarframeMarketApp.Pages.Components

@if (result == null) { return; }

@if (result.Error != null) { <p style="color:#c62828;">@result.Error</p> }
else if (result.NotFound) { <MAlert Dense Type="@AlertTypes.Error">未找到该用户：@UserName</MAlert> }
else
{
	if (result.User != null)
	{
		<p class="mt-2"><strong>@result.User.IngameName</strong> — @result.User.Platform — 声望 @result.User.Reputation — @result.User.LastSeenLocal.ToString("g")</p>
	}
	if (result.Orders != null && result.Orders.Count > 0)
	{
		<MButton Small Text OnClick="@(() => _collapsed = !_collapsed)" Class="mb-1">
			<MIcon Small>@(_collapsed ? "mdi-chevron-right" : "mdi-chevron-down")</MIcon>
			@UserName — @result.Orders.Count 个订单
		</MButton>
		@if (!_collapsed)
		{
			<p class="text-caption">@(result.LoadingPrices ? " — 加载中..." : "")</p>
			<MDataTable Items="result.Orders" Headers="_headers" Dense HideDefaultFooter ItemsPerPage="-1" Loading="@result.Loading" MustSort
						ShowExpand ItemKey="r => r.Id"
						GroupBy="nameof(Order.Type)" GroupDesc="[true]">
				<GroupHeaderContent>
					<td colspan="@_headers.Count">
						@if (context.Group is "buy" or "Buy") { @("购") } else { @("售") }
					</td>
				</GroupHeaderContent>
				<ItemColContent>
					@if (context.Header.Text == "物品") { @GetItemName(result, context.Item) }
					else if (context.Header.Text == "英文名称") { @GetEnName(result, context.Item) }
					else if (context.Header.Text == "参考价") { @GetRef(result, context.Item) }
					else if (context.Header.Text == "差价") { @GetDiff(result, context.Item) }
					else { @context.Value?.ToString() }
				</ItemColContent>
				<ExpandedItemContent>
					<td colspan="9999"><OrderTop TargetItem="@GetItemShort(result, context.Item2)" /></td>
				</ExpandedItemContent>
			</MDataTable>
		}
	}
	else if (!result.Loading) { <p>无公开订单</p> }
}
