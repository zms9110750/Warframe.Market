@page "/user"
@attribute [NavItem("用户订单", "mdi-account-search", Order = 1)]

@* 标签栏 *@
<MTabs Value="@activeTabIndex">
	<MTab OnClick="@(() => { activeTabIndex = 0; StateHasChanged(); })">搜索</MTab>
	@foreach (var (name, idx) in _pinnedUsers.Select((t, i) => (t, i)))
	{
		var realIdx = idx + 1;
		<MTab OnClick="@(() => { activeTabIndex = realIdx; StateHasChanged(); })">
			@name
			@if (canWrite)
			{
				<MButton Small Icon OnClick="@(() => UnpinUser(name))">
					<MIcon Small Style="color:orange;">mdi-pin-off</MIcon>
				</MButton>
			}
		</MTab>
	}
	@foreach (var (name, idx) in _activeUsers.Select((t, i) => (t, i)))
	{
		if (_pinnedUsers.Contains(name)) continue;
		var realIdx = idx + 1 + _pinnedUsers.Count;
		<MTab OnClick="@(() => { activeTabIndex = realIdx; StateHasChanged(); })">
			@(name.Length > 20 ? $"{name[..20]}…" : name)
			@if (canWrite)
			{
				<MButton Small Icon OnClick="@(() => PinUser(name))">
					<MIcon Small>mdi-pin-outline</MIcon>
				</MButton>
			}
			else
			{
				<MButton Small Icon OnClick="@(() => CloseUserTab(idx))">
					<MIcon Small>mdi-close</MIcon>
				</MButton>
			}
		</MTab>
	}
</MTabs>

@if (activeTabIndex == 0)
{
	<MTextField @bind-Value="slug" Label="输入用户名（/分隔多用户）" Clearable Dense Solo Class="mb-4" Style="max-width: 400px;" />
	<MButton OnClick="SearchAsync" Color="primary">查询</MButton>
}

@* 显示所有已加载用户的结果 *@
@{
	var allUsers = new List<string>();
	allUsers.AddRange(_pinnedUsers);
	allUsers.AddRange(_activeUsers.Where(u => !_pinnedUsers.Contains(u)));
	var userIdx = activeTabIndex - 1;
}
@if (userIdx >= 0 && userIdx < allUsers.Count)
{
	var currentUser = allUsers[userIdx];
	if (_userResults.TryGetValue(currentUser, out var result))
	{
		<UserResultTable UserName="@currentUser" result="result" />
	}
	else if (_searchingUsers.Contains(currentUser)) { <MProgressCircular Indeterminate Size="20" Width="2" Class="mt-4" /> }
}
