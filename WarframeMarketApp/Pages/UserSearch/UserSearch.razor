@page "/user"
@attribute [NavItem("用户订单", "mdi-account-search", Order = 1)]

@* 标签栏 *@
<UserTabs activeTabIndex="@activeTabIndex" activeTabIndexChanged="@((v) => activeTabIndex = v)"
		  _pinnedUsers="@_pinnedUsers" _activeUsers="@_activeUsers"
		  canWrite="@canWrite"
		  PinUser="@((string n) => PinUser(n))" UnpinUser="@((string n) => UnpinUser(n))"
		  CloseTab="@((int i) => CloseUserTab(i))" />

@if (activeTabIndex == 0)
{
	<MTextField @bind-Value="slug" Label="输入用户名（/分隔多用户）" Clearable Dense Solo Class="mb-4" Style="max-width: 400px;" />
	<MButton OnClick="SearchAsync" Color="primary">查询</MButton>
}

@* 显示所有已加载用户的结果 *@
@{
	var allUsers = new List<string>();
	allUsers.AddRange(_pinnedUsers);
	allUsers.AddRange(_activeUsers.Where(u => !_pinnedUsers.Contains(u)));
	var userIdx = activeTabIndex - 1;
}
@if (userIdx >= 0 && userIdx < allUsers.Count)
{
	var currentUser = allUsers[userIdx];
	if (_userResults.TryGetValue(currentUser, out var result))
	{
		<UserResultTable UserName="@currentUser" result="result" />
	}
	else if (_searchingUsers.Contains(currentUser)) { <MProgressCircular Indeterminate Size="20" Width="2" Class="mt-4" /> }
}
