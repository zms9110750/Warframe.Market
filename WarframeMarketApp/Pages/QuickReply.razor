@page "/reply"
@attribute [NavItem("快捷回复", "mdi-reply-all", Order = 3)]

<h3>快捷回复</h3>
<p class="text-caption mb-4">点击复制到剪贴板</p>

<div style="display:flex;flex-direction:column;gap:8px;max-width:400px;">
	@foreach (var (label, template) in templates)
	{
		<MButton Outlined Block OnClick="@(() => Copy(template))">@label</MButton>
	}
</div>

@if (copied != null)
{
	<MAlert Dense Class="mt-4" Type="@AlertTypes.Success">已复制: @copied</MAlert>
}
